{
  "name": "@handshack/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "HandShack desktop application (Electron).",
  "author": "HandShack contributors",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "package:dir": "electron-vite build && electron-builder --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@handshack/core": "*",
    "@handshack/ui": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "38.8.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "vite": "^6.0.7"
  }
}
